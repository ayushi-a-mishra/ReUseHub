# Supabase Project Credentials
# Obtain these from your Supabase Project Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# College Configuration
VITE_COLLEGE_NAME="Apex Institute of Technology & Sciences"
VITE_COLLEGE_ALLOWED_DOMAINS="apex.edu,campus.edu,college.ac.in,student.apex.edu"

# Demo Mode Configuration (allows 1-click test logins without email verification)
VITE_ENABLE_DEMO_ACCOUNTS=true
